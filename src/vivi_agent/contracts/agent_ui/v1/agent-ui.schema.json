{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivi.local/contracts/agent-ui/v1/agent-ui.schema.json",
  "title": "ViVi Agent-UI public contract v1",
  "oneOf": [
    { "$ref": "#/$defs/messageRequest" },
    { "$ref": "#/$defs/confirmRequest" },
    { "$ref": "#/$defs/cancelRequest" },
    { "$ref": "#/$defs/simulationControlRequest" },
    { "$ref": "#/$defs/resetRequest" },
    { "$ref": "#/$defs/completedResponse" },
    { "$ref": "#/$defs/blockedResponse" },
    { "$ref": "#/$defs/needsConfirmationResponse" },
    { "$ref": "#/$defs/failedResponse" },
    { "$ref": "#/$defs/degradedResponse" },
    { "$ref": "#/$defs/proposalEvent" },
    { "$ref": "#/$defs/decisionEvent" },
    { "$ref": "#/$defs/executionEvent" },
    { "$ref": "#/$defs/stateChangedEvent" },
    { "$ref": "#/$defs/activeActionEvent" },
    { "$ref": "#/$defs/turnProgressEvent" },
    { "$ref": "#/$defs/responseChunkEvent" }
  ],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "requestBase": {
      "type": "object",
      "required": ["contract_version", "kind", "request_type", "session_id", "request_id", "occurred_at"],
      "properties": {
        "contract_version": { "enum": ["1.0.0", "1.1.0"] }, "kind": { "const": "request" },
        "request_type": { "type": "string" }, "session_id": { "$ref": "#/$defs/identifier" },
        "request_id": { "$ref": "#/$defs/identifier" }, "occurred_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "messageRequest": {
      "allOf": [{ "$ref": "#/$defs/requestBase" }, {
        "type": "object", "required": ["turn_id", "message"],
        "properties": { "request_type": { "const": "message" }, "turn_id": { "$ref": "#/$defs/identifier" }, "message": { "type": "string", "minLength": 1 } }
      }], "unevaluatedProperties": false
    },
    "confirmRequest": {
      "allOf": [{ "$ref": "#/$defs/requestBase" }, {
        "type": "object", "required": ["turn_id", "proposal_id", "confirmation_id"],
        "properties": { "request_type": { "const": "confirm" }, "turn_id": { "$ref": "#/$defs/identifier" }, "proposal_id": { "$ref": "#/$defs/identifier" }, "confirmation_id": { "$ref": "#/$defs/identifier" } }
      }], "unevaluatedProperties": false
    },
    "cancelRequest": {
      "allOf": [{ "$ref": "#/$defs/requestBase" }, {
        "type": "object", "required": ["turn_id", "proposal_id", "confirmation_id"],
        "properties": { "request_type": { "const": "cancel" }, "turn_id": { "$ref": "#/$defs/identifier" }, "proposal_id": { "$ref": "#/$defs/identifier" }, "confirmation_id": { "$ref": "#/$defs/identifier" } }
      }], "unevaluatedProperties": false
    },
    "simulationControlRequest": {
      "allOf": [{ "$ref": "#/$defs/requestBase" }, {
        "type": "object", "required": ["control", "parameters"],
        "properties": { "request_type": { "const": "simulation_control" }, "control": { "enum": ["set_state", "load_preset", "tick"] }, "parameters": { "type": "object" } }
      }], "unevaluatedProperties": false
    },
    "resetRequest": {
      "allOf": [{ "$ref": "#/$defs/requestBase" }, {
        "type": "object", "required": ["scope"],
        "properties": { "request_type": { "const": "reset" }, "scope": { "enum": ["session", "simulator", "all"] } }
      }], "unevaluatedProperties": false
    },
    "responseBase": {
      "type": "object", "required": ["contract_version", "kind", "status", "session_id", "turn_id", "request_id", "occurred_at", "message"],
      "properties": {
        "contract_version": { "enum": ["1.0.0", "1.1.0"] }, "kind": { "const": "response" }, "status": { "type": "string" },
        "session_id": { "$ref": "#/$defs/identifier" }, "turn_id": { "$ref": "#/$defs/identifier" }, "request_id": { "$ref": "#/$defs/identifier" },
        "occurred_at": { "$ref": "#/$defs/timestamp" }, "message": { "type": "string", "minLength": 1 }
      }
    },
    "completedResponse": { "allOf": [{ "$ref": "#/$defs/responseBase" }, { "type": "object", "properties": { "status": { "const": "completed" }, "proposal_id": { "$ref": "#/$defs/identifier" }, "execution_id": { "$ref": "#/$defs/identifier" }, "state_version": { "type": "integer", "minimum": 0 } } }], "unevaluatedProperties": false },
    "blockedResponse": { "allOf": [{ "$ref": "#/$defs/responseBase" }, { "type": "object", "required": ["reason", "rule_id", "state_version"], "properties": { "status": { "const": "blocked" }, "reason": { "type": "string" }, "proposal_id": { "$ref": "#/$defs/identifier" }, "rule_id": { "$ref": "#/$defs/identifier" }, "state_version": { "type": "integer", "minimum": 0 } } }], "unevaluatedProperties": false },
    "needsConfirmationResponse": { "allOf": [{ "$ref": "#/$defs/responseBase" }, { "type": "object", "required": ["proposal_id", "confirmation_id", "expires_at"], "properties": { "status": { "const": "needs_confirmation" }, "proposal_id": { "$ref": "#/$defs/identifier" }, "confirmation_id": { "$ref": "#/$defs/identifier" }, "expires_at": { "$ref": "#/$defs/timestamp" } } }], "unevaluatedProperties": false },
    "failedResponse": { "allOf": [{ "$ref": "#/$defs/responseBase" }, { "type": "object", "required": ["error"], "properties": { "status": { "const": "failed" }, "proposal_id": { "$ref": "#/$defs/identifier" }, "execution_id": { "$ref": "#/$defs/identifier" }, "error": { "type": "object", "required": ["code", "message", "retryable"], "additionalProperties": false, "properties": { "code": { "$ref": "#/$defs/identifier" }, "message": { "type": "string" }, "retryable": { "type": "boolean" } } } } }], "unevaluatedProperties": false },
    "degradedResponse": { "allOf": [{ "$ref": "#/$defs/responseBase" }, { "type": "object", "required": ["degraded_capability", "retryable"], "properties": { "status": { "const": "degraded" }, "reason": { "type": "string" }, "proposal_id": { "$ref": "#/$defs/identifier" }, "degraded_capability": { "$ref": "#/$defs/identifier" }, "retryable": { "type": "boolean" } } }], "unevaluatedProperties": false },
    "eventBase": {
      "type": "object", "required": ["contract_version", "kind", "event_type", "event_id", "sequence", "session_id", "turn_id", "request_id", "occurred_at", "actor"],
      "properties": {
        "contract_version": { "enum": ["1.0.0", "1.1.0"] }, "kind": { "const": "event" }, "event_type": { "type": "string" },
        "event_id": { "$ref": "#/$defs/identifier" }, "sequence": { "type": "integer", "minimum": 1 }, "session_id": { "$ref": "#/$defs/identifier" },
        "turn_id": { "$ref": "#/$defs/identifier" }, "request_id": { "$ref": "#/$defs/identifier" }, "occurred_at": { "$ref": "#/$defs/timestamp" },
        "actor": { "enum": ["USER", "AGENT", "GUARDRAIL", "VEHICLE", "OPERATOR", "SYSTEM"] }
      }
    },
    "proposalEvent": { "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "required": ["proposal_id", "intent", "summary"], "properties": { "event_type": { "const": "proposal" }, "proposal_id": { "$ref": "#/$defs/identifier" }, "intent": { "$ref": "#/$defs/identifier" }, "summary": { "type": "string" } } }], "unevaluatedProperties": false },
    "decisionEvent": { "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "required": ["proposal_id", "outcome", "reason_code", "rule_id", "state_version"], "properties": { "event_type": { "const": "decision" }, "proposal_id": { "$ref": "#/$defs/identifier" }, "outcome": { "enum": ["ALLOW", "BLOCK_UNSAFE", "BLOCK_UNAVAILABLE", "CONFIRM", "NOT_VOICE_ACTIONABLE", "ANSWER", "UNKNOWN"] }, "reason_code": { "$ref": "#/$defs/identifier" }, "rule_id": { "$ref": "#/$defs/identifier" }, "state_version": { "type": "integer", "minimum": 0 } } }], "unevaluatedProperties": false },
    "executionEvent": { "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "required": ["proposal_id", "execution_id", "intent", "phase"], "properties": { "event_type": { "const": "execution" }, "proposal_id": { "$ref": "#/$defs/identifier" }, "execution_id": { "$ref": "#/$defs/identifier" }, "intent": { "$ref": "#/$defs/identifier" }, "phase": { "enum": ["started", "succeeded", "failed", "stopped"] }, "detail": { "type": "object" } } }], "unevaluatedProperties": false },
    "stateChangedEvent": { "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "required": ["state_version", "changes"], "properties": { "event_type": { "const": "state_changed" }, "state_version": { "type": "integer", "minimum": 0 }, "changes": { "type": "object" }, "source_execution_id": { "$ref": "#/$defs/identifier" } } }], "unevaluatedProperties": false },
    "activeActionEvent": { "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "required": ["proposal_id", "execution_id", "active_action_id", "intent", "phase"], "properties": { "event_type": { "const": "active_action" }, "proposal_id": { "$ref": "#/$defs/identifier" }, "execution_id": { "$ref": "#/$defs/identifier" }, "active_action_id": { "$ref": "#/$defs/identifier" }, "intent": { "$ref": "#/$defs/identifier" }, "phase": { "enum": ["started", "progress", "stopped", "failed", "completed"] }, "progress": { "type": "number", "minimum": 0, "maximum": 1 } } }], "unevaluatedProperties": false },
    "turnProgressEvent": { "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "required": ["phase", "progress"], "properties": { "contract_version": { "const": "1.1.0" }, "event_type": { "const": "turn_progress" }, "phase": { "enum": ["received", "resolving", "proposing", "authorizing", "executing", "responding", "completed", "failed"] }, "progress": { "type": "number", "minimum": 0, "maximum": 1 }, "message": { "type": "string", "minLength": 1 } } }], "unevaluatedProperties": false },
    "responseChunkEvent": { "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "required": ["stream_id", "chunk_index", "delta", "content_kind", "final"], "properties": { "contract_version": { "const": "1.1.0" }, "event_type": { "const": "response_chunk" }, "stream_id": { "$ref": "#/$defs/identifier" }, "chunk_index": { "type": "integer", "minimum": 0, "maximum": 511 }, "delta": { "type": "string", "minLength": 1, "maxLength": 4096 }, "content_kind": { "enum": ["answer", "clarification", "status"] }, "final": { "type": "boolean" } } }], "unevaluatedProperties": false }
  }
}
